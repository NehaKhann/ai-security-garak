{
  "rest": {
    "RestGenerator": {
      "name": "Spring Boot demo chatbot",
      "uri": "http://127.0.0.1:8080/api/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response"
    }
  }
}
